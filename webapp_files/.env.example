# Copy this file to .env and fill in your own values. Never commit .env.
# Generate a key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='replace-me'
DEBUG=True
LOG_LEVEL=INFO

# Local development defaults. On the course VM, set these to the assigned host
# values, for example ALLOWED_HOSTS=.yourdomain.dev and
# CSRF_TRUSTED_ORIGINS=https://*.yourdomain.dev.
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset locally to use SQLite. The course VM supplies it.
