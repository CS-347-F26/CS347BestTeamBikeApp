# Copy this file to .env and fill in your own values. Never commit .env.
# Generate a key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY='replace-me'
DJANGO_DEBUG=True
# Comma-separated domains this copy is served from. Each teammate hosts on their
# own subdomain, so on your server use yours (e.g. bikeapp.mrossiter.me).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
