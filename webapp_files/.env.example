# Copy this file to .env and fill in your own values. Never commit .env.
# Generate a key with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY='replace-me'
DEBUG=True
LOG_LEVEL=INFO

# Local development defaults. On the course VM, set these to the assigned host
# values, for example ALLOWED_HOSTS=.yourdomain.dev and
# CSRF_TRUSTED_ORIGINS=https://*.yourdomain.dev.
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset locally to use SQLite. The course VM supplies it.

# Area riders can import routes in (routes/import/). Optional; the default is
# Harrisonburg, VA. Bounds are west,south,east,north in degrees.
# ROUTE_AREA_NAME=the Harrisonburg area
# ROUTE_AREA_BOUNDS=-78.95,38.38,-78.80,38.51
